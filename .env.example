# Copy to .env.local for local development. Never commit real values.
# Where each variable lives in staging/prod: docs/architecture/ci-cd.md#secrets-and-variables

# Supabase (local values are printed by `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_…): safe in the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server only, acts as the `service_role` Postgres role.
# Used solely by kiosk and cron SQL functions (docs/architecture/auth-and-security.md)
SUPABASE_SECRET_KEY=

# Long random secrets: `openssl rand -base64 48`
KIOSK_TOKEN=
CRON_SECRET=
